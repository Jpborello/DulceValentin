SITE_URL=https://www.elpaquetero.com.ar
AGENT_SECRET=
# Opcional: nombre exacto de la impresora (tal cual figura en Windows).
# Si se deja vacio, usa la impresora predeterminada de esa PC.
PRINTER_NAME=
POLL_INTERVAL_MS=5000

# --- Respaldo automatico en esta PC (punto local) ---
# Usa el mismo AGENT_SECRET, salvo que en el sitio se cargue un
# BACKUP_AGENT_SECRET aparte (en ese caso poner el mismo valor aca).
BACKUP_AGENT_SECRET=
BACKUP_ENABLED=true
# Cada cuantas horas se hace la copia (ademas de una al arrancar).
BACKUP_INTERVAL_HOURS=6
# Cuantas copias fechadas se guardan antes de borrar las mas viejas.
BACKUP_KEEP=30
# Carpeta destino. Vacio = C:\Users\<usuario>\Backups_DulceValentin
BACKUP_DIR=
